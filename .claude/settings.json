{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "cymbal hook nudge --format=claude-code",
            "marker": "cymbal-hook",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "cymbal hook remind --format=claude-code --update=if-stale",
            "marker": "cymbal-hook",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
